---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Queer & Trans Tours in Tulum | Queerness Experiences" description={"Small-group tours in Tulum for queer travelers and families. Secret cenote, Muyil river float, jungle and monkeys, street food, and the stories behind the storefront."}>

<header class="head">
  <div class="shape-y"></div>
  <p class="head-eye">★ Small-group tours</p>
  <h1>The Tours</h1>
  <p>Every tour is small and personal, often just your group. Tap any tour to see what the day looks like.</p>
</header>

<section class="tours">

  <!-- SECRET CENOTE -->
  <div class="tour">
    <input type="checkbox" id="tour1" checked>
    <label class="tour-head" for="tour1">
      <div class="tour-photo">PHOTO — SECRET CENOTE (entrance through the well, underground water)</div>
      <div class="tour-bar">
        <span class="tour-name">Secret Cenote</span>
        <span class="tour-toggle">+</span>
      </div>
      <p class="tour-oneline">A cenote not even locals know about. The entrance is an ancient well created by the Maya.</p>
    </label>
    <div class="tour-body">
      <div class="tour-body-inner">
        <p class="tour-desc">Tours to a cenote not even locals know about. The entrance is an ancient well created by the Maya. You enter through the well, down into cool, still water that has been here for thousands of years. Cared for by an extremely knowledgeable Maya family. The kind of spot you'd never find on your own, and never forget once you have.</p>
        <p class="tour-desc">Optional add-on: Secret Cenote + Botanical Tour. [ ADD-ON PRICE — let me know and I'll add it. ]</p>
        <div class="tour-meta">
          <span class="meta-pill">Underground cenote</span>
          <span class="meta-pill">Local Maya family</span>
          <span class="meta-pill">Swimming</span>
        </div>
        <div class="tour-foot">
          <span class="tour-price">FROM 2,200 MXN / PERSON</span>
          <a href="#" class="btn-book">Book This →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- MUYIL -->
  <div class="tour">
    <input type="checkbox" id="tour2">
    <label class="tour-head" for="tour2">
      <div class="tour-photo">PHOTO — MUYIL RIVER FLOAT (canals, mangroves, open sky)</div>
      <div class="tour-tag">Most booked</div>
      <div class="tour-bar">
        <span class="tour-name">Muyil River Float</span>
        <span class="tour-toggle">+</span>
      </div>
      <p class="tour-oneline">Relaxation tour. Float through canals built by the ancient Maya.</p>
    </label>
    <div class="tour-body">
      <div class="tour-body-inner">
        <p class="tour-desc">Relaxation tour. Float through canals built by the ancient Maya. Boat through lagoons and mangroves. It's the most relaxing day in Tulum, and the one people keep talking about long after they get home. Bring nothing but yourself. The water does the rest.</p>
        <div class="tour-meta">
          <span class="meta-pill">Ancient Mayan canals</span>
          <span class="meta-pill">Mangroves &amp; lagoons</span>
          <span class="meta-pill">Floating</span>
        </div>
        <div class="tour-foot">
          <span class="tour-price">FROM 3,400 MXN / PERSON</span>
          <a href="#" class="btn-book">Book This →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- STORIES BEHIND THE STOREFRONT -->
  <div class="tour">
    <input type="checkbox" id="tour3">
    <label class="tour-head" for="tour3">
      <div class="tour-photo">PHOTO — STORIES BEHIND THE STOREFRONT (local shops, food, makers)</div>
      <div class="tour-tag">Culture &amp; food</div>
      <div class="tour-bar">
        <span class="tour-name">Town Chisme</span>
        <span class="tour-toggle">+</span>
      </div>
      <p class="tour-oneline">Local shops, murals, and the real Tulum behind the tourist version.</p>
    </label>
    <div class="tour-body">
      <div class="tour-body-inner">
        <p class="tour-desc">Find out what it's like to live in Tulum. Get the chisme, eat our favorite food, and go out to the places that make people want to call this place home. This is the town behind the town, the locally-owned shops, the makers, and the people whose stories you'd never hear as a tourist passing through. We stop where the owners know us by name, explore the murals, taste what the neighborhood actually eats, and trade the polished tourist version of Tulum for the real one. You'll leave knowing the difference between the Tulum people visit and the Tulum people live in.</p>
        <div class="tour-meta">
          <span class="meta-pill">Local shops &amp; makers</span>
          <span class="meta-pill">Murals</span>
          <span class="meta-pill">Food included</span>
          <span class="meta-pill">Walking</span>
        </div>
        <div class="tour-foot">
          <span class="tour-price">FROM 2,400 MXN / PERSON</span>
          <a href="#" class="btn-book">Book This →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- STREET FOOD -->
  <div class="tour">
    <input type="checkbox" id="tour4">
    <label class="tour-head" for="tour4">
      <div class="tour-photo">PHOTO — STREET FOOD (tacos, food trucks, elotes)</div>
      <div class="tour-tag">Food · Drinks included</div>
      <div class="tour-bar">
        <span class="tour-name">Street Food Tour</span>
        <span class="tour-toggle">+</span>
      </div>
      <p class="tour-oneline">Walking food tours to the best food trucks in Tulum.</p>
    </label>
    <div class="tour-body">
      <div class="tour-body-inner">
        <p class="tour-desc">Walking food tours to the best food trucks in Tulum. Tacos, tostilocos/elotes, and traditional treats. Come hungry and let someone who knows exactly where to stop do the ordering.</p>
        <div class="tour-meta">
          <span class="meta-pill">Food &amp; drinks included</span>
          <span class="meta-pill">Walking</span>
          <span class="meta-pill">Local spots</span>
        </div>
        <div class="tour-foot">
          <span class="tour-price">FROM 2,000 MXN / PERSON</span>
          <a href="#" class="btn-book">Book This →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- MONKEY SPOTTING -->
  <div class="tour">
    <input type="checkbox" id="tour5">
    <label class="tour-head" for="tour5">
      <img class="tour-photo" src="/images/punta-laguna-canoes.jpg" alt="Canoes at Punta Laguna, part of the Monkey Spotting jungle lagoon adventure">
      <div class="tour-tag">Most adventurous</div>
      <div class="tour-bar">
        <span class="tour-name">Monkey Spotting + Lagoon Jungle Adventure</span>
        <span class="tour-toggle">+</span>
      </div>
      <p class="tour-oneline">Our most adventurous tour. Spend the day in the jungle looking for wild monkeys.</p>
    </label>
    <div class="tour-body">
      <div class="tour-body-inner">
        <p class="tour-desc">Our most adventurous tour. Spend the day in the jungle looking for wild monkeys while enjoying swimming, canoeing, and zip lining over a pristine lagoon. And because your guide is a UCLA wildlife biologist, you'll actually understand what you're looking at, not just see it. Includes picnic lunch.</p>
        <div class="tour-meta">
          <span class="meta-pill">Wild spider monkeys</span>
          <span class="meta-pill">Zip line &amp; canoe</span>
          <span class="meta-pill">Lunch included</span>
        </div>
        <div class="tour-foot">
          <span class="tour-price">FROM 4,000 MXN / PERSON</span>
          <a href="#" class="btn-book">Book This →</a>
        </div>
      </div>
    </div>
  </div>

  <div class="tours-note">
    <strong>Honeymooners, couples, friend groups, solo travelers, all welcome.</strong> Every tour is small. Bigger group, retreat, or event? That becomes a private tour, sized and priced for your group.
  </div>

  <div class="tours-note">
    <strong>Want something more low-key?</strong> Street Food and Town Chisme are easy, walkable days if cenotes and jungle hikes aren't your thing.
  </div>

  <div class="food-feature">
    <div class="ph food-feature-photo">PHOTO — EATING DELICIOUSLY (local bakery, chef, market fruit)</div>
    <p class="food-feature-caption">Eating deliciously is a priority, not an afterthought. Local bakeries, an amazing chef, seasonal local fruit, never a resort buffet.</p>
    <p class="food-feature-credit">Meals by <a href="https://pausaydanza.com" target="_blank" rel="noopener">Pausa y Danza</a> · Bakery <a href="https://instagram.com/muchachita_tulum" target="_blank" rel="noopener">@muchachita_tulum</a></p>
  </div>

  <div class="tours-gallery">
    <img src="/images/secret-cenote-cave.jpg" alt="Entering the Secret Cenote through the cave">
    <img src="/images/muyil-river-float-group.jpg" alt="Group on the Muyil River Float tour">
    <img src="/images/punta-laguna-canoes.jpg" alt="Canoes at Punta Laguna">
    <img src="/images/tours-gallery-boat.jpg" alt="Boating through the mangroves">
    <img src="/images/tours-gallery-picnic.jpg" alt="Picnic with local fruit on tour">
  </div>

</section>

<section class="reviews" id="tour-reviews">
  <p class="sec-eye" style="color:var(--white);">Don't take our word for it</p>
  <h2>What people say</h2>
  <p class="scroll-hint">← swipe to read more →</p>
  <div class="review-scroll">
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="trev1" class="rev-toggle">
      <p class="rtext">Ay ay ay, what a time!!! Santi was a dream. The entire tour, start to finish, through Tulum and into the jungle and down into the cenote was better than I ever could've imagined.</p>
      <label for="trev1" class="rev-more">Read more</label>
      <p class="rname">— Corinna Harris, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="trev2" class="rev-toggle">
      <p class="rtext">My partner and I booked two tours with Santi during our trip to Tulum, Street Food in the evening and Cenotes the next day. Before the trip, Santi was incredibly communicative and helpful as I planned, offering amazing local recs.</p>
      <label for="trev2" class="rev-more">Read more</label>
      <p class="rname">— Madge Dietrich, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="trev3" class="rev-toggle">
      <p class="rtext">We found Santi on Reddit while looking for queer experiences in Tulum and had a great tailored tour of the Muyil river. During the tour, they use their extensive knowledge in marine biology to share facts about the river.</p>
      <label for="trev3" class="rev-more">Read more</label>
      <p class="rname">— Diana Ledesma, Google review</p>
    </div>
  </div>
  <a href="https://www.google.com/maps/place/Queerness+Experiences/@20.4203707,-87.5893973,94594m/data=!3m1!1e3!4m8!3m7!1s0x213eac5d05676035:0x9ad4bb88e0a769c2!8m2!3d20.4200372!4d-87.259726!9m1!1b1!16s%2Fg%2F11w4tpph1c?hl=en" target="_blank" rel="noopener" class="btn-reviews">Read all reviews on Google →</a>
</section>

<section class="cta" id="book">
  <p class="cta-eye">Book a tour</p>
  <h2>When are you<br>arriving?</h2>
  <p>Tell me your dates and which tour caught your eye. I'll reply within 24 hours.</p>
  <form class="cta-form" action="#" method="post">
    <div class="cta-row2">
      <input class="cta-in" type="text" name="first_name" placeholder="First name" required>
      <input class="cta-in" type="text" name="last_name" placeholder="Last name">
    </div>
    <input class="cta-in" type="text" name="pronouns" placeholder="Pronouns (e.g. she/her, they/them)">
    <input class="cta-in" type="email" name="email" placeholder="Email" required>
    <input class="cta-in" type="tel" name="whatsapp" placeholder="WhatsApp (include country code, e.g. +1 555 123 4567)">
    <input class="cta-in" type="text" name="dates" placeholder="Dates you're coming to Tulum">
    <select class="cta-in cta-select" name="tour">
      <option value="" disabled selected>Which tour interests you?</option>
      <option>Secret Cenote</option>
      <option>Muyil River Float</option>
      <option>Secret Cenote + Muyil (both)</option>
      <option>Town Chisme</option>
      <option>Street Food Tour</option>
      <option>Monkey Spotting + Lagoon Jungle Adventure</option>
      <option>Group trip or retreat</option>
      <option>Not sure yet, help me choose</option>
    </select>
    <textarea class="cta-in" name="message" rows="3" placeholder="What's up? Tell me what you're looking for"></textarea>
    <button type="submit" class="btn-cta-form">Send. I'll reply within 24 hours</button>
  </form>
</section>

</Layout>

<style is:global>
@font-face{font-family:'CheddarGothicStencil';src:url('/fonts/CheddarGothicStencil.woff2') format('woff2');font-weight:normal;font-style:normal;font-display:swap;}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{overflow-x:hidden;max-width:100vw;}
:root{
  --magenta:#C8185A;--yellow:#F5A623;--terra:#B5390F;--dark:#1a1a18;
  --white:#FDFCF9;--bone:#F5F0E8;--muted:#4A4034;--border:rgba(26,26,24,0.12);
  --s-sm:16px;--s-md:32px;--s-lg:64px;
  --ff:'Archivo Black','Space Grotesk',sans-serif;--fb:'Space Grotesk',sans-serif;
}
body{background:var(--bone);color:var(--dark);font-family:var(--fb);font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
a{color:inherit;text-decoration:none;}

/* NAV */
/* HEADER */
.head{background:var(--magenta);padding:var(--s-md) var(--s-sm) var(--s-lg);position:relative;overflow:hidden;}
.shape-y{position:absolute;top:0;right:0;width:38%;height:46%;background:var(--yellow);clip-path:polygon(28% 0,100% 0,100% 100%,0 100%);z-index:0;}
.head-eye{font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.8);margin-bottom:var(--s-sm);position:relative;z-index:2;}
.head h1{font-family:var(--ff);font-size:44px;line-height:0.94;text-transform:uppercase;color:var(--white);position:relative;z-index:2;-webkit-text-stroke:1.5px rgba(0,0,0,0.3);paint-order:stroke fill;margin-bottom:var(--s-sm);}
.head p{font-size:14.5px;color:rgba(255,255,255,0.9);line-height:1.7;position:relative;z-index:2;max-width:520px;}

/* ACCORDION — image-first */
.tours{padding:var(--s-md) var(--s-sm) var(--s-lg);}
.tour{border:3px solid var(--dark);margin-bottom:var(--s-sm);box-shadow:5px 5px 0 var(--dark);overflow:hidden;background:var(--bone);}
.tour input{position:absolute;opacity:0;pointer-events:none;}
.tour-head{cursor:pointer;position:relative;display:block;}
.tour-photo{width:100%;aspect-ratio:3/2;object-fit:cover;background:repeating-linear-gradient(135deg,rgba(26,26,24,0.05),rgba(26,26,24,0.05) 12px,rgba(26,26,24,0.09) 12px,rgba(26,26,24,0.09) 24px);display:flex;align-items:center;justify-content:center;font-size:10px;letter-spacing:0.06em;text-transform:uppercase;color:rgba(26,26,24,0.4);text-align:center;padding:12px;border-bottom:3px solid var(--dark);}
.tour-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--white);}
.tour-name{font-family:var(--ff);font-size:22px;color:var(--dark);text-transform:uppercase;line-height:1;}
.tour-toggle{font-family:var(--fb);font-size:22px;font-weight:700;color:var(--magenta);line-height:1;transition:transform 0.2s;}
.tour input:checked ~ .tour-head .tour-toggle{transform:rotate(45deg);}
.tour-tag{position:absolute;top:0;left:0;background:var(--magenta);color:var(--white);font-family:var(--fb);font-size:9px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:5px 10px;border-right:3px solid var(--dark);border-bottom:3px solid var(--dark);z-index:2;}
.tour-body{max-height:0;overflow:hidden;transition:max-height 0.3s ease;background:var(--white);}
.tour input:checked ~ .tour-body{max-height:800px;}
.tour-body-inner{padding:0 16px 18px;}
.tour-desc{font-size:14px;color:var(--muted);line-height:1.7;margin-bottom:var(--s-sm);}
.tour-meta{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:var(--s-sm);}
.meta-pill{font-family:var(--fb);font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;padding:4px 10px;background:var(--bone);border:2px solid var(--dark);color:var(--dark);}
.tour-foot{display:flex;align-items:center;justify-content:space-between;border-top:2px solid var(--border);padding-top:14px;}
.tour-price{font-size:13px;font-weight:700;color:var(--dark);}
.btn-book{background:var(--magenta);color:var(--white);font-family:var(--fb);font-size:11px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;padding:10px 16px;border:2px solid var(--dark);box-shadow:3px 3px 0 var(--dark);}

/* NOTE */
.tours-note{background:var(--yellow);border:3px solid var(--dark);box-shadow:5px 5px 0 var(--dark);padding:16px 18px;font-size:13.5px;color:var(--dark);line-height:1.65;font-weight:500;margin-top:var(--s-md);}

/* TOURS GALLERY — scroll for more photos */
.tours-gallery{display:flex;gap:12px;overflow-x:auto;scrollbar-width:none;margin-top:var(--s-md);scroll-snap-type:x mandatory;}
.tours-gallery::-webkit-scrollbar{display:none;}
.tours-gallery img{flex:0 0 78%;max-width:320px;aspect-ratio:4/5;object-fit:cover;border:3px solid var(--dark);box-shadow:5px 5px 0 var(--magenta);scroll-snap-align:start;}
@media(min-width:720px){
  .tours-gallery img{flex:0 0 260px;}
}
.tours-note strong{font-weight:700;}

/* CTA */
.cta{background:var(--dark);padding:var(--s-lg) var(--s-sm);text-align:center;}
.cta h2{font-family:var(--ff);font-size:32px;color:var(--white);text-transform:uppercase;line-height:1;margin-bottom:var(--s-sm);}
.cta p{font-size:14px;color:rgba(255,255,255,0.7);margin-bottom:var(--s-md);line-height:1.6;}
.btn-cta{display:inline-block;background:var(--yellow);color:var(--dark);font-family:var(--fb);font-size:13px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;padding:15px 28px;border:3px solid var(--yellow);}
.cta-eye{font-family:var(--fb);font-size:11.5px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--yellow);margin-bottom:12px;}
.cta-form{display:flex;flex-direction:column;gap:14px;max-width:520px;margin:var(--s-md) auto 0;text-align:left;}
.cta-row2{display:flex;gap:12px;}
.cta-row2 .cta-in{flex:1;}
.cta-in{background:rgba(255,255,255,0.08);border:2px solid rgba(255,255,255,0.35);padding:13px 14px;font-size:15px;font-family:var(--fb);color:var(--white);outline:none;width:100%;}
.cta-in::placeholder{color:rgba(255,255,255,0.45);}
.cta-in:focus{border-color:var(--yellow);}
.cta-select{color:rgba(255,255,255,0.6);}
.cta-select option{background:var(--dark);color:var(--white);}
.btn-cta-form{background:var(--yellow);color:var(--dark);padding:15px;font-size:13px;font-weight:700;font-family:var(--fb);letter-spacing:0.04em;text-transform:uppercase;border:3px solid var(--yellow);cursor:pointer;}

/* FOOTER */
footer{background:var(--dark);padding:var(--s-md) var(--s-sm);border-top:3px solid var(--yellow);display:flex;flex-direction:column;gap:var(--s-sm);}
.flogo{font-family:var(--fb);font-size:16px;font-weight:700;color:var(--magenta);line-height:1.15;}
.flinks{display:flex;flex-wrap:wrap;gap:var(--s-sm);list-style:none;}
.flinks a{font-size:12px;font-weight:500;color:rgba(255,255,255,0.5);}

@media(min-width:720px){
  nav{padding:0 40px;}
  .head{padding:var(--s-lg) 40px;}
  .head h1{font-size:64px;}
  .tours{padding:var(--s-md) 40px var(--s-lg);max-width:760px;margin:0 auto;}
  .cta{padding:var(--s-lg) 40px;}
  footer{flex-direction:row;align-items:center;justify-content:space-between;padding:var(--s-md) 40px;}
}
</style>

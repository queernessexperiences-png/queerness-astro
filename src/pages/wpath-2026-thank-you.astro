---
import Layout from '../layouts/Layout.astro';
---
<Layout title="You're Pre-Registered | WPATH 2026 | Queerness Experiences" description={"Thanks for pre-registering for WPATH 2026 experiences in Mexico City."}>

<div class="wpt-wrap">
  <div class="wpt-inner">
    <p class="wpt-eyebrow">You're on the list</p>
    <h1 class="wpt-title">Thank you for<br>pre-registering.</h1>
    <p class="wpt-body">We'll reach out as soon as your group reaches the minimum size to confirm, usually between 4 and 6 people per experience. No payment is due until then.</p>
    <p class="wpt-body">In the meantime, if your plans change or you have questions, just reply to the confirmation email you'll receive shortly.</p>

    <div class="wpt-tulum">
      <img src="https://static.wixstatic.com/media/44aee0_29ba316a87a442cf81b472eb524bb73e~mv2.png" alt="Queerness Experiences" class="wpt-tulum-logo">
      <div>
        <p class="wpt-tulum-eyebrow">Also by Queerness Experiences</p>
        <p class="wpt-tulum-text">Queer tours in Tulum, cenotes, jungle, street food, and the local spots most visitors never find. If your trip includes a stop there, or you're already dreaming about a future one, take a look.</p>
        <a href="/tours" class="wpt-tulum-btn">Explore Tulum Tours →</a>
      </div>
    </div>

    <a href="/wpath-2026" class="wpt-back">← Back to WPATH 2026 experiences</a>
  </div>
</div>

</Layout>

<style is:global>
  .wpt-wrap{background:#2e3f52;padding:64px 24px;min-height:60vh;display:flex;align-items:center;}
  .wpt-inner{max-width:560px;margin:0 auto;}
  .wpt-eyebrow{font-family:'DM Sans',sans-serif;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#d4b06e;margin-bottom:12px;}
  .wpt-title{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:clamp(36px,8vw,52px);color:#faf6f0;line-height:1.1;margin-bottom:24px;}
  .wpt-body{font-family:'DM Sans',sans-serif;font-size:15px;color:rgba(255,255,255,0.65);line-height:1.8;font-weight:300;margin-bottom:16px;max-width:460px;}
  .wpt-tulum{display:flex;gap:16px;align-items:flex-start;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:24px;margin-top:32px;margin-bottom:32px;}
  .wpt-tulum-logo{width:44px;height:44px;object-fit:contain;flex-shrink:0;}
  .wpt-tulum-eyebrow{font-family:'DM Sans',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#b8924a;margin-bottom:8px;}
  .wpt-tulum-text{font-family:'DM Sans',sans-serif;font-size:14px;color:rgba(255,255,255,0.6);line-height:1.7;font-weight:300;margin-bottom:14px;}
  .wpt-tulum-btn{display:inline-block;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:#2a1810;background:#b8924a;padding:12px 20px;border-radius:2px;text-decoration:none;}
  .wpt-back{font-family:'DM Sans',sans-serif;font-size:13px;color:rgba(255,255,255,0.5);text-decoration:none;border-bottom:1px solid rgba(255,255,255,0.2);padding-bottom:2px;}

  @media(min-width:720px){
    .wpt-wrap{padding:96px 48px;}
  }
</style>

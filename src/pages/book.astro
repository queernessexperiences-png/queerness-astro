---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a Tour | Queerness Experiences" description={"Book a queer-friendly tour in Tulum. Tell me your dates and I'll reply within 24 hours."}>

<section class="contact" id="contact">
  <p class="sec-eye">Book a tour</p>
  <h2>When are you<br>arriving?</h2>
  <p class="contact-lead">Tell me your dates and which tour interests you. I'll reply within 24 hours.</p>
  <form class="form" name="contact" method="POST" netlify>
    <input type="hidden" name="form-name" value="contact" />
    <div style="display:flex;gap:12px;">
      <div style="flex:1;"><label class="fl">First name</label><input class="fi" type="text" name="first-name" placeholder="First name"></div>
      <div style="flex:1;"><label class="fl">Last name</label><input class="fi" type="text" name="last-name" placeholder="Last name"></div>
    </div>
    <div><label class="fl">Pronouns</label><input class="fi" type="text" name="pronouns" placeholder="e.g. she/her, they/them, he/him"></div>
    <div><label class="fl">Email</label><input class="fi" type="email" name="email" placeholder="your@email.com"></div>
    <div><label class="fl">WhatsApp (include your country code)</label><input class="fi" type="tel" name="whatsapp" placeholder="e.g. +1 555 123 4567"></div>
    <div><label class="fl">Dates you're coming to Tulum</label><input class="fi" type="text" name="dates" placeholder="e.g. July 12–19"></div>
    <div>
      <label class="fl">Which tour(s) interest you? Pick as many as you like</label>
      <div class="tour-checks">
        <label class="tour-check"><input type="checkbox" name="tour" value="Secret Cenote"> Secret Cenote</label>
        <label class="tour-check"><input type="checkbox" name="tour" value="Muyil River Float"> Muyil River Float</label>
        <label class="tour-check"><input type="checkbox" name="tour" value="Stories Behind the Storefront"> Stories Behind the Storefront</label>
        <label class="tour-check"><input type="checkbox" name="tour" value="Street Food"> Street Food</label>
        <label class="tour-check"><input type="checkbox" name="tour" value="Monkey Spotting"> Monkey Spotting</label>
        <label class="tour-check"><input type="checkbox" name="tour" value="Upcoming group trip"> Upcoming group trip</label>
        <label class="tour-check"><input type="checkbox" name="tour" value="Not sure yet"> Not sure yet — help me choose</label>
      </div>
    </div>
    <div><label class="fl">What's up? Tell me what you're looking for</label><textarea class="fi" name="message" rows="3" placeholder="A little about your trip, your group, or what you're hoping for" style="resize:vertical;font-family:var(--fb);"></textarea></div>
    <button type="submit" class="fsub">Send — I'll reply within 24 hours</button>
  </form>
</section>

</Layout>

<style>
  .tour-checks{display:flex;flex-direction:column;gap:8px;}
  .tour-check{display:flex;align-items:center;gap:10px;background:var(--white);border:2px solid var(--dark);padding:11px 14px;font-family:var(--fb);font-size:14.5px;color:var(--dark);cursor:pointer;}
  .tour-check input{width:18px;height:18px;accent-color:var(--magenta);flex-shrink:0;cursor:pointer;}
</style>

      <div class="wp-card-date">Nov 9</div>
    </div>
    <div class="wp-card-body">
      <div class="wp-card-title">Prehispanic Cooking Class</div>
      <div class="wp-card-meta">
        <div class="wp-card-meta-item">📅 Monday Nov 9 · Morning</div>
        <div class="wp-card-meta-item">📍 Doña Vero · Roma Norte · 30–45 min from hotel</div>
        <div class="wp-card-meta-item">⏱ ~3 hrs · Up to 18 people</div>
      </div>

    .wp-accordion-wrap.open .wp-accordion-cards{max-height:9000px;}
    .wp-accordion-wrap.open .wp-accordion-arrow{transform:rotate(45deg);}
    .wp-card-photo-wrap{width:55%;max-width:220px;margin:20px auto 0;border-radius:2px;}

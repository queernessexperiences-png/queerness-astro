</style>

<script>
  document.querySelectorAll('.wp-section-label').forEach((label) => {
    label.addEventListener('click', () => {
      if (window.innerWidth >= 720) return;
      const id = label.getAttribute('data-target');
      document.querySelectorAll('.wp-accordion-wrap').forEach((wrap) => {
        if (wrap.id === id) wrap.classList.toggle('open');
        else wrap.classList.remove('open');
      });
    });
  });
</script>

---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Free Queer Tulum Guidebook | Queerness Experiences" description={"Free queer Tulum guidebook — real recommendations for food, coffee, getting around, and exchanging money, from someone who actually lives here."}>

<section class="guide" id="guide" style="border-top:none;">
  <div class="guide-inner">
    <p class="sec-eye" style="color:var(--yellow);">Free Tulum recommendations</p>
    <h2>Stop planning.<br><span class="accent">Start enjoying.</span></h2>
    <p class="guide-lead">My real recommendations for when you visit — free.</p>
    <div class="guide-photo">PHOTO — TULUM FOOD / COFFEE / STREET SCENE (warm, real, makes them want to be here)</div>
    <div class="guide-box">
      <ul class="ginc">
        <li>My favorite coffee shop, restaurant, and a queer-friendly bar</li>
        <li>No Uber in Tulum — here's the taxi app locals use for the best prices</li>
        <li>ATMs are set up to charge you on the conversion. Here's the way around it.</li>
      </ul>
      <a href="/blog/queer-tulum-recommendations" class="btn-p" style="text-align:center;">Read the Full Guidebook →</a>
      <div class="gstat">Book any tour and the full guidebook is yours free.</div>
    </div>
  </div>
</section>

</Layout>

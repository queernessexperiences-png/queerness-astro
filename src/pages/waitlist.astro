---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Join the Camp Queerness Waitlist | Queerness Experiences" description={"Join the waitlist for Camp Queerness, an upcoming overnight summer camp for sapphic, queer, and trans adults in Tulum."}>

<section class="contact" id="waitlist">
  <p class="sec-eye">Coming soon</p>
  <h2>Join the Camp<br>Queerness waitlist</h2>
  <p class="contact-lead">Be the first to know when dates and details are confirmed.</p>
  <form class="form" name="camp-queerness-waitlist" method="POST" data-netlify="true" action="/thank-you">
    <input type="hidden" name="form-name" value="camp-queerness-waitlist" />
    <div style="display:flex;gap:12px;">
      <div style="flex:1;"><label class="fl">First name</label><input class="fi" type="text" name="first-name" placeholder="First name" required></div>
      <div style="flex:1;"><label class="fl">Last name</label><input class="fi" type="text" name="last-name" placeholder="Last name" required></div>
    </div>
    <div><label class="fl">Pronouns</label><input class="fi" type="text" name="pronouns" placeholder="e.g. she/her, they/them"></div>
    <div><label class="fl">Email</label><input class="fi" type="email" name="email" placeholder="your@email.com" required></div>
    <div><label class="fl">Phone number</label><input class="fi" type="tel" name="phone" placeholder="Include country code, e.g. +1 555 123 4567" required></div>
    <div><label class="fl">How many people?</label><input class="fi" type="text" name="group-size" placeholder="Just you, or a group?"></div>
    <div><label class="fl">Why do you want to join Camp Queerness?</label><textarea class="fi" name="reason" rows="3" placeholder="Tell me a bit about you" style="resize:vertical;font-family:var(--fb);"></textarea></div>
    <button type="submit" class="fsub">Join the Waitlist</button>
  </form>
</section>

</Layout>

---
import Layout from '../layouts/Layout.astro';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Queerness Experiences',
  description: 'Queer Tulum tours and group trips, Mexican-owned and operated. LGBTQ+ travel experiences for lesbian, sapphic, gay, bi, trans, and queer travelers.',
  url: 'https://queernessexperiences.com',
  image: 'https://queernessexperiences.com/images/group-trips-photo.jpg',
  founder: { '@type': 'Person', name: 'Santi Solis' },
  areaServed: { '@type': 'City', name: 'Tulum' },
  address: { '@type': 'PostalAddress', addressLocality: 'Tulum', addressRegion: 'Quintana Roo', addressCountry: 'MX' },
};
---
<Layout title="Queer Tulum Tours & Group Trips | Queerness Experiences" description={"Queer Tulum tours and group trips, Mexican-owned and operated. LGBTQ+ travel experiences for lesbian, sapphic, gay, bi, trans, and queer travelers, queer families, and queer destination weddings. Led by Santi Solis, UCLA wildlife biologist and local queer guide."}>
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

<!-- HERO — dominant H1, then photo grid, then body, then CTAs -->
<header class="hero">
  <div class="shape-y"></div>
  <div class="shape-t"></div>
  <div class="hero-text">
    <p class="hero-eye">★ Mexican-Owned &amp; Operated · LGBTQIA+ Travel Experiences in Latin America</p>
    <h1>
      <span class="l l1">Tours &amp; group trips</span>
      <span class="l l2">for queer &amp; trans</span>
      <span class="l l3">people</span>
      <span class="l l4">in Tulum.</span>
    </h1>
    <div class="hero-grid">
      <img src="/images/hero-grid-mangroves-crop.jpg" alt="Friends swimming through the mangroves in Tulum">
      <img src="/images/hero-grid-cenote-friends.jpg" alt="Friends laughing together at a cenote in Tulum">
      <img src="/images/secret-cenote-cave.jpg" alt="A couple at the entrance of the Secret Cenote in Tulum">
      <img src="/images/IMG_0477.jpeg" alt="A couple laughing together on a jungle trail in Tulum">
    </div>
    <p class="hero-body">For sapphic, queer, and trans travelers who prioritize small, local businesses, want to learn about culture respectfully, and are excited to be shown a side of Mexico they never had access to before, all in a space that's affirming to their identity.</p>
    <div class="cta-stack">
      <a href="#tours" class="btn-p">See the Tours →</a>
      <a href="/group-trips" class="btn-s">Queer Camp for Grownups →</a>
    </div>
    <a href="#reviews" class="hero-social-proof">
      <span class="stars">★★★★★</span>
      <span>19 five-star reviews</span>
    </a>
  </div>
</header>

<!-- QUEER-FRIENDLY BAR — under hero -->
<section style="background:var(--yellow);border-bottom:6px solid var(--blue);padding:20px var(--s-sm);">
  <p style="font-size:17px;color:var(--dark);line-height:1.6;font-weight:500;max-width:640px;margin:0 auto;text-align:center;">Tulum being queer and trans friendly surprises people. It's not a queer-centric town, but you'll see queer and gender-diverse people any time you walk out on the street. We're a regular part of the community and of daily life here.</p>
  <div style="width:36px;height:2px;background:var(--dark);opacity:0.25;margin:14px auto;"></div>
  <p style="font-size:12.5px;color:var(--dark);opacity:0.85;line-height:1.5;max-width:520px;margin:0 auto;text-align:center;">Is your hotel or destination already this welcoming, but not sure how to show it? <a href="/work-with-me" style="color:var(--blue);font-weight:700;">Let's talk →</a></p>
</section>

<!-- BRIDGE + CREDENTIALS — one unified about-me block -->
<section class="bridge">
  <div class="bridge-inner">
    <img class="bridge-photo" src="/images/santi-hero-tulum.jpg" alt="Santi laughing in the water near Tulum, wearing a life vest">
    <div class="bridge-text">
      <p class="small" style="margin-top:0;">Meet the founder</p>
      <p><strong>I'm Santi (they/them).</strong> Born in Mexico. Raised in the U.S. Came home to build a life in Tulum.</p>
      <p class="small">Fun facts about me</p>
      <div class="creds" aria-label="Fun facts">
        <div class="cred"><div class="cnum">01</div><div><div class="ct">Former UCLA Wildlife Biologist</div><div class="cd">I studied marmots. Let's get nerdy about the plants and animals along the way.</div></div></div>
        <div class="cred"><div class="cnum">02</div><div><div class="ct">Pattie Gonia Scholarship</div><div class="cd">Queer Outdoor Expedition recipient, 2023.</div></div></div>
        <div class="cred"><div class="cnum">03</div><div><div class="ct">International Conference Speaker</div><div class="cd">On designing experiences for queer and trans travelers.</div></div></div>
        <a href="/group-trips" class="cred" style="text-decoration:none;color:inherit;"><div class="cnum">04</div><div><div class="ct">Creator of Curated Group Trips &amp; Retreats</div><div class="cd">See the trips →</div></div></a>
        <div class="cred"><div class="cnum">05</div><div><div class="ct">FOLX Campaign Model</div><div class="cd">Recently cast as a model for FOLX, the queer and trans telehealth company.</div></div></div>
      </div>
      <a href="/about" class="bridge-more">More about me →</a>
    </div>
  </div>
</section>

<!-- GUIDE — above tours -->
<section class="guide" id="guide">
  <div class="guide-inner">
    <div class="guide-intro">
      <p class="sec-eye" style="color:var(--yellow);">Free Tulum recommendations</p>
      <h2>Stop planning.<br><span class="accent">Start enjoying.</span></h2>
      <p class="guide-lead">My real recommendations for when you visit, free.</p>
    </div>
    <div class="guide-box">
      <ul class="ginc">
        <li>My favorite coffee shop, restaurant, and a queer-friendly bar</li>
        <li>No Uber in Tulum: here's the taxi app locals use for the best prices</li>
        <li>ATMs are set up to charge you on the conversion. Here's the way around it.</li>
        <li>A playlist to get you excited for the trip</li>
      </ul>
      <a href="/blog/queer-tulum-recommendations" class="btn-p" style="text-align:center;">Get the Free Recommendations →</a>
      <div class="gstat">Book any tour and the full guidebook is yours free.</div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section class="reviews" id="reviews">
  <div class="reviews-inner">
  <p class="sec-eye" style="color:var(--yellow);">Our reviews</p>
  <h2>What queer &amp; trans<br>travelers say</h2>
  <div class="review-scroll">
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev3" class="rev-toggle">
      <p class="rtext"><strong>The website and guide were super helpful.</strong> They MADE my trip to Tulum. Santi is very responsive and knowledgeable about Tulum. I did the cenote and the street food tours and they were AMAZING. I highly highly recommend both — they were so different but each gave me a glimpse of Tulum I never would have seen without the tour. Santi is an absolute delight. The cenotes were stunning. The food was delicious. The culture and educational experience was phenomenal. I can't say enough good things.</p>
      <label for="rev3" class="rev-more">Read more +</label>
      <p class="rname">— Chashaa Johnson, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev2" class="rev-toggle">
      <p class="rtext"><strong>Santi made exploring and connecting feel effortless</strong>, when in reality, I never would have found the spaces, knowledge, fun, and people without them.</p>
      <label for="rev2" class="rev-more">Read more +</label>
      <p class="rname">— Haley Gowland, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev1" class="rev-toggle">
      <p class="rtext">I procrastinated in writing this review because anything I say will be an understatement to <strong>how delightful Santi is, how fantastic their tours are</strong>, and how the whole experience will easily become the highlight of any trip to Tulum.</p>
      <label for="rev1" class="rev-more">Read more +</label>
      <p class="rname">— Kristen Eckstrand, Google review</p>
    </div>
    <div class="rcard">
      <div class="rstars">★★★★★</div>
      <input type="checkbox" id="rev4" class="rev-toggle">
      <p class="rtext">I had such an amazing time on this tour! As a foodie, I really appreciated checking out La Norteña and eating all the authentic, delicious food that Santi recommended.</p>
      <label for="rev4" class="rev-more">Read more +</label>
      <p class="rname">— Marissa Herrera, Local Guide, Google review</p>
    </div>
  </div>
  <div class="review-scroll-nav">
    <button type="button" class="scroll-arrow scroll-arrow-left" aria-label="Scroll to previous review" onclick="this.closest('.reviews-inner').querySelector('.review-scroll').scrollBy({left:-320,behavior:'smooth'})">←</button>
    <button type="button" class="scroll-arrow scroll-arrow-right" aria-label="Scroll to next review" onclick="this.closest('.reviews-inner').querySelector('.review-scroll').scrollBy({left:320,behavior:'smooth'})">→</button>
  </div>
  <a href="https://www.google.com/maps/place/Queerness+Experiences/@20.4203707,-87.5893973,94594m/data=!3m1!1e3!4m8!3m7!1s0x213eac5d05676035:0x9ad4bb88e0a769c2!8m2!3d20.4200372!4d-87.259726!9m1!1b1!16s%2Fg%2F11w4tpph1c?hl=en" target="_blank" rel="noopener" class="btn-reviews">Read all 19 reviews on Google →</a>
  </div>
</section>

<!-- TOURS — two flagships + mini boxes -->
<section class="tours" id="tours">
  <div class="tours-inner">
    <p class="sec-eye">What we do</p>
    <h2>The tours</h2>
    <p class="tours-lead">Tours run small. Bigger group, retreat, or event? That becomes a private tour, sized and priced for your group.</p>

    <div class="food-feature">
      <p class="food-feature-caption">Eating deliciously is a priority. Local bakeries, locally-owned restaurants, an amazing chef, seasonal local fruit. Every tour is tailored to dietary restrictions and allergies.</p>
    </div>

    <div class="flagship-row">
      <div class="flagship">
        <img class="ph flag-photo flag-photo-tall" src="/images/secret-cenote-cave.jpg" alt="Entering the Secret Cenote through a wooden ladder into the cave">
        <div class="flag-body">
          <div class="flag-name">Secret Cenote</div>
          <p class="flag-desc">A cenote not even locals know about. The entrance is an ancient well created by the Maya.</p>
          <input type="checkbox" id="flagmore1" class="flag-toggle-check">
          <label for="flagmore1" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>You enter through a well, into water that's been here for thousands of years. Cared for by an extremely knowledgeable Maya family.</p></div>
          <div class="flag-foot">
            <span class="flag-price">FROM 2,200 MXN / PERSON</span>
            <a href="/tours" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
      <div class="flagship">
        <img class="ph flag-photo flag-photo-tall" src="/images/muyil-river-float-group.jpg" alt="Group floating in the mangroves on the Muyil River Float tour">
        <div class="flag-tag">Most booked</div>
        <div class="flag-body">
          <div class="flag-name">Muyil River Float</div>
          <p class="flag-desc">Relaxation tour. Float through canals built by the ancient Maya.</p>
          <input type="checkbox" id="flagmore2" class="flag-toggle-check">
          <label for="flagmore2" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Boat through lagoons and mangroves. The most relaxing day in Tulum, and the one people keep talking about when they get home.</p></div>
          <div class="flag-foot">
            <span class="flag-price">FROM 3,400 MXN / PERSON</span>
            <a href="/tours" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="flagship-row">
      <div class="flagship">
        <img class="ph flag-photo" src="/images/secret-cenote-group.jpg" alt="Friends laughing together at an open cenote on the Intro to Cenotes Tour in Tulum">
        <div class="flag-body">
          <div class="flag-name">Intro to Cenotes Tour</div>
          <p class="flag-desc">Two off-the-beaten-path cenotes, cave and open water.</p>
          <input type="checkbox" id="flagmore6" class="flag-toggle-check">
          <label for="flagmore6" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Taak Bi Ha, an amazing cave cenote with great lighting for freediving, and Nicte Ha, a fully open cenote with lily pads, cliff jumping, and amazing snorkeling.</p></div>
          <div class="flag-foot">
            <span class="flag-price">FROM 2,800 MXN / PERSON</span>
            <a href="/tours" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
      <div class="flagship">
        <img class="ph flag-photo" src="/images/town-chisme-tacos.jpg" alt="Santi enjoying a huge taco spread on the Town Chisme tour in Tulum">
        <div class="flag-body">
          <div class="flag-name">Town Chisme</div>
          <p class="flag-desc">Explore the local side of Tulum.</p>
          <input type="checkbox" id="flagmore3" class="flag-toggle-check">
          <label for="flagmore3" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Morning coffee or cacao and breakfast, then shop curated vintage stores and local thrift stores, the town behind the town.</p></div>
          <div class="flag-foot">
            <span class="flag-price">FROM 2,500 MXN / PERSON</span>
            <a href="/tours" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="flagship-row">
      <div class="flagship">
        <img class="ph flag-photo" src="/images/tour-photo-street-food-churro.jpg" alt="Friends holding churros on a Tulum street food tour at night">
        <div class="flag-body">
          <div class="flag-name">Food Tour</div>
          <p class="flag-desc">Explore prehispanic Mexican food and the amazing fusions that make Tulum one of the best places to eat.</p>
          <input type="checkbox" id="flagmore4" class="flag-toggle-check">
          <label for="flagmore4" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Choose your style: three street food stops, or three sit-down spots. Street food or sit-down, your choice.</p></div>
          <div class="flag-foot">
            <span class="flag-price">PRICE BY EXPERIENCE</span>
            <a href="/tours" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
      <div class="flagship">
        <img class="ph flag-photo" src="/images/monkey-spotting-lagoon.jpg" alt="Looking out over the lagoon at Punta Laguna on the Monkey Spotting tour">
        <div class="flag-body">
          <div class="flag-name">Monkey Spotting + Lagoon Jungle Adventure</div>
          <p class="flag-desc">Our most adventurous tour. Spend the day in the jungle looking for wild monkeys.</p>
          <input type="checkbox" id="flagmore5" class="flag-toggle-check">
          <label for="flagmore5" class="flag-toggle-label"><span class="more">+ More details</span><span class="less">− Less details</span></label>
          <div class="flag-more"><p>Swimming, canoeing, and zip lining over a pristine lagoon. Includes picnic lunch. Led by a UCLA wildlife biologist, so you actually understand what you're looking at.</p></div>
          <div class="flag-foot">
            <span class="flag-price">FROM 4,000 MXN / PERSON</span>
            <a href="/tours" class="flag-link">See Full Itinerary →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="tours-all">
      <a href="/tours" class="btn-alltours">See the Tours →</a>
      <a href="/group-trips" class="btn-alltours" style="box-shadow:5px 5px 0 var(--magenta);margin-top:16px;">Group Trips &amp; Retreats →</a>
    </div>
  </div>
</section>

<!-- GROUP TRIPS COMING UP -->
<section class="groups" id="groups">
  <p class="sec-eye">Coming up</p>
  <h2>Camp<br>Queerness</h2>
  <p class="groups-tagline">Summer camp, reimagined for sapphic, queer, and trans grownups, with an added Mexican flair.</p>
  <p class="groups-tagline" style="margin-bottom:8px;">For people who want to:</p>
  <ul class="trips-details-list groups-details-list">
    <li>Play mermaids at a private cenote</li>
    <li>Kayak at sunset in the biosphere</li>
    <li>Experience and learn about traditional Mexican and pre-Hispanic food</li>
    <li>Listen to and share stories at night</li>
    <li>Learn new dance moves</li>
    <li>Explore the jungle</li>
    <li>Birdwatch</li>
    <li>Learn fun cultural nuances of Mexican culture</li>
  </ul>
  <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-bottom:var(--s-md);max-width:640px;">
    <img src="/images/IMG_3923.jpeg" alt="Kayaking at sunset near Tulum" style="width:140px;height:140px;object-fit:cover;border:3px solid var(--dark);box-shadow:5px 5px 0 var(--yellow);flex-shrink:0;">
    <p style="background:var(--bone);border:3px solid var(--dark);box-shadow:5px 5px 0 var(--yellow);padding:14px 18px;font-weight:700;color:var(--dark);font-size:14.5px;line-height:1.5;flex:1;min-width:200px;margin:0;">Fun cultural nuance you'll learn: we don't just say "sí." There are a couple other options, one involves a finger, one involves an egg.</p>
  </div>
  <a href="/group-trips" class="btn-groups">See Camp Queerness →</a>
</section>

<!-- FRIEND -->
<section class="friend">
  <div class="friend-inner">
    <div class="friend-intro">
      <p class="sec-eye">In the area?</p>
      <h2>Looking for a<br>queer friend?</h2>
      <p>I do a lot of activities, you're welcome to join!</p>
    </div>
    <div class="friend-box">
      <p class="hobbies">Dance class · jiu jitsu · life drawing night · theatre in Spanish · and whatever else is happening that week.</p>
      <a href="mailto:info@queernessexperiences.com?subject=Let's%20hang%20out" class="btn-friend" style="display:inline-block;text-decoration:none;text-align:center;">Message me, let's join a class together →</a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="faq" id="faq">
  <p class="sec-eye">Before you book</p>
  <h2>Questions queer &amp;<br>trans travelers ask</h2>
  <div class="faq-list">
    <div class="faq-item">
      <input type="checkbox" id="faq1" checked>
      <label class="faq-q" for="faq1">Is Tulum safe for LGBTQ+ travelers?<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Tulum is one of the most welcoming places in Mexico for LGBTQ+ visitors. I wrote a full, honest guide on what to expect. <a href="/blog/is-tulum-queer-trans-friendly">Read: Is Tulum LGBTQ+ Friendly?</a></div></div>
    </div>
    <div class="faq-item">
      <input type="checkbox" id="faq2">
      <label class="faq-q" for="faq2">Is Tulum LGBTQ+ friendly?<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Yes, with real nuance worth understanding before you arrive. Here's the honest version. <a href="/blog/is-tulum-queer-trans-friendly">Read: Is Tulum LGBTQ+ Friendly?</a></div></div>
    </div>
    <div class="faq-item">
      <input type="checkbox" id="faq3">
      <label class="faq-q" for="faq3">How big are the tour groups?<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Tours run small, so you're never in a crowd. Larger groups, retreats, and events become private tours, sized and priced for your group.</div></div>
    </div>
    <div class="faq-item">
      <input type="checkbox" id="faq4">
      <label class="faq-q" for="faq4">Do I need to book in advance?<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Ideally, yes. About a week's notice is great, especially December through March. But if it's short notice, just message me and I'll do my best to get you on a tour.</div></div>
    </div>
    <div class="faq-item">
      <input type="checkbox" id="faq5">
      <label class="faq-q" for="faq5">I'm traveling with people who aren't queer. Can they come on the tour?<span class="tog">+</span></label>
      <div class="faq-a"><div class="faq-a-inner">Absolutely, yes. Feel free to let us know more about your situation, and we're happy to help.</div></div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="contact" id="contact">
  <p class="sec-eye">Book a tour</p>
  <h2>When are you<br>arriving?</h2>
  <p class="contact-lead">Tell me your dates and which tour interests you. I'll reply within 24 hours.</p>
  <a href="/book" class="btn-p" style="display:inline-block;text-align:center;">Book Your Tour in Tulum →</a>
</section>

<!-- FOOTER -->

</Layout>


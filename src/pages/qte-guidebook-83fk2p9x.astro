  .gb-wrap{ background:#e9e4d8; }
  .gb-inner{ max-width:720px; margin:0 auto; padding:0 20px 80px; }

  .gb-cover{
    background:#2c4438; color:#f7f2e7; margin:0 -20px 40px; padding:56px 28px 40px;
    text-align:left;
  }
  .gb-cover-eye{ font-family:"source-sans-3",sans-serif; font-weight:600; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:#c07a3e; margin-bottom:20px; }

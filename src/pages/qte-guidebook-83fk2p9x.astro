  .gb-cover-rule{ width:56px; height:3px; background:#c07a3e; margin:18px 0; }
  .gb-cover-sub{ font-family:"playfair-display",serif; font-style:italic; font-size:19px; color:#f7f2e7; max-width:420px; margin-bottom:20px; }
  .gb-cover-tags{ font-family:"source-sans-3",sans-serif; font-size:12px; color:rgba(247,242,231,0.7); line-height:1.9; }

  .gb-sec{ padding:34px 0; border-bottom:1px solid rgba(34,48,31,0.13); }
  .gb-sec:last-child{ border-bottom:none; }

  .gb-band{
    display:inline-block; background:#2c4438; color:#f7f2e7;
    font-family:"source-sans-3",sans-serif; font-weight:600; font-size:11px;
    letter-spacing:0.14em; text-transform:uppercase; padding:8px 16px;
    border-radius:2px; margin-bottom:20px;
  }
  .gb-h1{ font-family:"playfair-display",serif; font-weight:700; font-size:30px; color:#2c4438; margin-bottom:10px; }
  .gb-h2{ font-family:"playfair-display",serif; font-weight:700; font-size:18px; color:#2c4438; margin-bottom:3px; }
  .gb-meta{ font-family:"playfair-display",serif; font-style:italic; font-size:13px; color:#c07a3e; margin-bottom:6px; }
  .gb-italic{ font-family:"playfair-display",serif; font-style:italic; font-size:14px; color:#5b6a55; margin-bottom:14px; }
  .gb-body{ font-family:"source-sans-3",sans-serif; font-size:15px; line-height:1.65; color:#22301f; max-width:640px; }
  .gb-note{ font-family:"source-sans-3",sans-serif; font-style:italic; font-size:13.5px; color:#5b6a55; margin-bottom:20px; }
  .gb-entry{ margin-bottom:24px; }
  .gb-tip{ margin-top:10px; font-family:"source-sans-3",sans-serif; font-size:13.5px; font-style:italic; color:#38543f; padding-left:14px; border-left:2px solid #c07a3e; }

  .gb-callout{ background:#2c4438; color:#f7f2e7; border-radius:6px; padding:26px 26px; margin:18px 0; text-align:center; }
  .gb-callout-k{ font-family:"playfair-display",serif; font-weight:700; font-size:17px; margin-bottom:8px; }
  .gb-callout-s{ font-family:"source-sans-3",sans-serif; font-size:13.5px; color:rgba(247,242,231,0.82); line-height:1.6; }
  .gb-callout-u{ display:inline-block; margin-top:12px; font-family:"source-sans-3",sans-serif; font-size:11.5px; letter-spacing:0.08em; font-weight:600; color:#c07a3e; text-transform:uppercase; text-decoration:none; }

  .gb-closing{ text-align:center; padding-top:50px; }
  .gb-thanks{ font-family:"playfair-display",serif; font-style:italic; font-size:14px; color:#5b6a55; margin-top:26px; line-height:1.7; }

  @media(min-width:720px){
    .gb-cover{ margin:0 0 50px; padding:72px 48px 56px; border-radius:8px; }
  }
</style>
